{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/Button/**",
              "components/core/Image/**",
              "components/forms/Input/**",
              "components/navigation/SharedHeader/**",
              "components/navigation/SharedSidebar/**",
              "ui_kits/app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Black Han Sans|Gaegu|Noto Sans KR))/i]",
        "message": "Font not provided by the design system. Available: Black Han Sans, Gaegu, Noto Sans KR."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|disabled|active|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, disabled, active, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|danger|default|chip)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'danger' | 'default' | 'chip'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Image'] > JSXAttribute > JSXIdentifier[name!=/^(?:shape|size|initials|style|key|ref|className|style|children)$/]",
        "message": "<Image> doesn't accept that prop. Declared props: shape, size, initials, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Image'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:round|square)$/]",
        "message": "<Image> shape must be one of 'round' | 'square'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|label|placeholder|value|onChange|checked|options|style|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: type, label, placeholder, value, onChange, checked, options, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:text|area|select|search|password|check|check-on|radio|radio-on|toggle|toggle-on)$/]",
        "message": "<Input> type must be one of 'text' | 'area' | 'select' | 'search' | 'password' | 'check' | 'check-on' | 'radio' | 'radio-on' | 'toggle' | 'toggle-on'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SharedHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|style|key|ref|className|style|children)$/]",
        "message": "<SharedHeader> doesn't accept that prop. Declared props: active, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SharedSidebar'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|style|key|ref|className|style|children)$/]",
        "message": "<SharedSidebar> doesn't accept that prop. Declared props: active, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "Button": {
        "replaces": []
      },
      "Image": {
        "replaces": []
      },
      "Input": {
